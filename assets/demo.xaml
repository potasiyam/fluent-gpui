<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      SystemBackdrop="Mica">

  <Page.Resources>
    <ResourceDictionary Source="demo-resources.xaml"/>
  </Page.Resources>

  <StackPanel Spacing="16" Padding="36,28,36,28" HorizontalAlignment="Center">
    <TextBlock Text="WinUI XAML on GPUI" FontSize="34" FontWeight="Bold"
               Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" />
    <TextBlock Text="roxmltree parser -> gpui-pre 0.3 renderer (DirectX, Mica backdrop)"
               HorizontalAlignment="Center" />

    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="18"
            BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" HorizontalAlignment="Center">
      <StackPanel Spacing="8">
        <TextBlock Text="{x:Bind ClicksText}" Style="{StaticResource AccentText}" />
        <TextBlock Text="State flows: Click handler -> AppState -> {x:Bind} re-render"
                   Style="{StaticResource BaseText}" />
      </StackPanel>
    </Border>

    <Button Content="Increment from XAML" Click="OnIncrement" HorizontalAlignment="Center" />
  </StackPanel>

</Page>
