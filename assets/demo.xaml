<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#FF1F1F1F">

  <StackPanel Spacing="14" Padding="36,28,36,28" HorizontalAlignment="Center">
    <TextBlock Text="WinUI XAML on GPUI" FontSize="34" FontWeight="Bold"
               Foreground="#FFF3F3F3" HorizontalAlignment="Center" />
    <TextBlock Text="roxmltree parser -> gpui 0.2 renderer (Blade/DX12, Windows)"
               FontSize="14" Foreground="#FF9C9C9C" HorizontalAlignment="Center" />

    <Border Background="#FF2D2D30" CornerRadius="8" Padding="18"
            BorderThickness="1" BorderBrush="#FF3F3F46" HorizontalAlignment="Center">
      <StackPanel Spacing="8">
        <TextBlock Text="{x:Bind ClicksText}" FontSize="16" Foreground="#FF4EC9B0" />
        <TextBlock Text="State flows: Click handler -> AppState -> {x:Bind} re-render"
                   FontSize="12" Foreground="#FF808080" />
      </StackPanel>
    </Border>

    <Button Content="Increment from XAML" Click="OnIncrement" HorizontalAlignment="Center" />
  </StackPanel>

</Page>
