<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="DemoTextBrush" Color="#FF1F1F1F"/>
      <SolidColorBrush x:Key="DemoSubtleBrush" Color="#FF606060"/>
      <SolidColorBrush x:Key="DemoPanelBrush" Color="#FFFFFFFF"/>
      <SolidColorBrush x:Key="DemoBorderBrush" Color="#FFC9C9C9"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="DemoTextBrush" Color="#FFF3F3F3"/>
      <SolidColorBrush x:Key="DemoSubtleBrush" Color="#FF9C9C9C"/>
      <SolidColorBrush x:Key="DemoPanelBrush" Color="#FF2D2D30"/>
      <SolidColorBrush x:Key="DemoBorderBrush" Color="#FF3F3F46"/>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <SolidColorBrush x:Key="DemoAccentBrush" Color="#FF4EC9B0"/>

  <Style x:Key="BaseText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{ThemeResource DemoSubtleBrush}"/>
  </Style>
  <Style x:Key="AccentText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="Foreground" Value="{StaticResource DemoAccentBrush}"/>
  </Style>
  <!-- Implicit style: defaults for every TextBlock without a Style. -->
  <Style TargetType="TextBlock">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Foreground" Value="{ThemeResource DemoSubtleBrush}"/>
  </Style>

</ResourceDictionary>
