  <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>

  <!-- REQ-TOK-04 M1 note: the icon-font indirection. -->
  <FontFamily x:Key="SymbolThemeFontFamily">Segoe Fluent Icons</FontFamily>
